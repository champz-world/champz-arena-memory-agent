# Copy to agent/.env — never commit the real file.

CHAMPZ_ARENA_BASE_URL=https://api.champz.world/game/spore-trainer/ai-agent
SIBYL_BRIDGE_BASE_URL=http://localhost:8787

# Filled in after the one-time `npm run dev -- register` step:
CHAMPZ_AGENT_API_KEY=
AGENT_WALLET_ADDRESS=

# Optional but strengthens the ACP-verifiability story for judges:
VIRTUALS_AGENT_ID=

GROQ_API_KEY=

# From https://app.virtuals.io/acp/new (Service Registry) -> agent's Signers tab.
# Real account-creation step on Virtuals' site, not generated by this codebase.
ACP_WALLET_ADDRESS=
ACP_WALLET_ID=
ACP_SIGNER_PRIVATE_KEY=
ACP_BUILDER_CODE=
